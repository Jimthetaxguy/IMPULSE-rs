{
    "type": "client",
    "name": "getaway_propose_move_activity",
    "description": "Stage a proposal to move an existing activity to a different day or time slot on the plan board. Nothing changes until the user confirms. Use when the user asks to move, reschedule, or swap an activity.",
    "response_timeout_secs": 20,
    "disable_interruptions": false,
    "interruption_mode": "allow",
    "force_pre_tool_speech": false,
    "pre_tool_speech": "auto",
    "assignments": [],
    "tool_call_sound_behavior": "auto",
    "tool_error_handling_mode": "auto",
    "parameters": {
        "type": "object",
        "required": [
            "activityName",
            "day",
            "summary"
        ],
        "description": "",
        "properties": {
            "activityName": {
                "type": "string",
                "description": "Name of the existing activity to move, as the user said it",
                "is_system_provided": false,
                "dynamic_variable": "",
                "allowed_values_dynamic_variable": "",
                "constant_value": "",
                "is_omitted": false
            },
            "day": {
                "type": "string",
                "description": "Target day, YYYY-MM-DD",
                "is_system_provided": false,
                "dynamic_variable": "",
                "allowed_values_dynamic_variable": "",
                "constant_value": "",
                "is_omitted": false
            },
            "slot": {
                "type": "string",
                "description": "Target time slot",
                "enum": [
                    "morning",
                    "afternoon",
                    "evening"
                ],
                "is_system_provided": false,
                "dynamic_variable": "",
                "allowed_values_dynamic_variable": "",
                "constant_value": "",
                "is_omitted": false
            },
            "summary": {
                "type": "string",
                "description": "One short line describing the change, e.g. 'Snorkel → Sun morning'",
                "is_system_provided": false,
                "dynamic_variable": "",
                "allowed_values_dynamic_variable": "",
                "constant_value": "",
                "is_omitted": false
            }
        }
    },
    "expects_response": true,
    "dynamic_variables": {
        "dynamic_variable_placeholders": {}
    },
    "execution_mode": "immediate"
}