# Impulse ephemeral state (tracked: HISTORY.jsonl, GENOME.md, config.json)
# Applies to .impulse/ dirs at any depth (root + impulse-rs/)
**/.impulse/LIVE_STATE.json
**/.impulse/SESSIONS.json
**/.impulse/retrieval.db
**/.impulse/retrieval.lock
**/.impulse/retrieval_index_state.json
**/.impulse/context/
**/.impulse/sockets/
**/.impulse/docs_cache/
**/.impulse/embeddings/

# SQLite WAL/SHM files and rebuildable databases
*.db-wal
*.db-shm
memory-pipeline/knowledge.db

# Deprecated TypeScript project (superseded by impulse-rs)
cockpit/

# Legacy Rust project (superseded by impulse-rs)
cockpit-rs/

# Tauri auto-generated schemas (regenerated by cargo tauri dev)
**/src-tauri/gen/

# Build artifacts
target/
node_modules/
dist/
*.wasm
!zellij-plugins/**/*.wasm

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Bun
bun.lockb

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Cloned repos (large, re-cloneable)
cloned-repos/

# Archived code (preserved locally, not committed)
archive/

# Experimental spike tests (not for version control)
spike/

# Environment
.env
.env.local

# Ralph Loop state (regenerated each session)
.opencode/
